# Database (Neon). Leave the placeholder to run in demo mode.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional — login with Google appears only when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Receipt scan (optional — scan photo returns 503 until set; text entry always works)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Force demo mode even when DATABASE_URL is set (set to "false" to disable demo mode)
DEMO_MODE=""
